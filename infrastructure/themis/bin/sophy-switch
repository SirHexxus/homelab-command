#!/usr/bin/env python3
"""Move a Themis-managed tablet between its Sophy policy configurations.

Modes (see lib/sophy_headwind.py for the naming scheme and the rules):

    school   "<number>: School"      the fail-closed default; kills ADB
    free     "<number>: Free Time"   parent action only, never scheduled
    lock     "Sophy: Locked"         nothing usable
    admin    "Sophy: Admin"          everything open, for setting a tablet up
    unlock   alias for school

This is the backend for the cron lock and the NFC/Tasker macro; the parent
control page (bin/sophy-web) shares the same client module.

Credentials come from the environment only (never arguments, never a file
in this repo):

    THEMIS_URL       https://themis.sirhexx.com
    THEMIS_USER      panel user with the edit_devices permission
    THEMIS_PASSWORD  its password

For cron, put those in ~/.config/themis/env (mode 0600) and source it.

Examples:
    sophy-switch sophy-01 school
    sophy-switch sophy-01 free --dry-run
    sophy-switch sophy-02 admin
    sophy-switch --all lock
    sophy-switch --list
    sophy-switch --status
"""

# ── Standard library imports ──────────────────────────────────────────────────
import argparse
import sys
from pathlib import Path

# Allow importing from lib/ when running from the project root or bin/
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

# ── Local imports ─────────────────────────────────────────────────────────────
from lib.sophy_headwind import (  # noqa: E402
    ALL_DEVICES,
    MODE_ALIASES,
    MODE_ORDER,
    MODES,
    SHARED_MODES,
    ConfigError,
    HeadwindError,
    device_states,
    env_config,
    list_configurations,
    login,
    switch,
)


# ── Functions ─────────────────────────────────────────────────────────────────

def print_configurations(configurations: dict[str, int]) -> None:
    """List the server's configurations, marking the Sophy ones."""
    by_id = {cfg_id: name for name, cfg_id in configurations.items()}
    suffixes = tuple(f': {label}' for label in MODES.values())
    for cfg_id in sorted(by_id):
        name = by_id[cfg_id]
        marker = '*' if name.endswith(suffixes) or name in SHARED_MODES.values() else ' '
        print(f'{marker} {cfg_id:>4}  {name}')


def print_status(states: list[dict]) -> None:
    """Show which configuration each tablet is in right now."""
    for state in states:
        mode = state['mode'] or '?'
        print(f'{state["number"]}  {mode:<7} {state["configuration"]}')


def main() -> None:
    parser = argparse.ArgumentParser(
        description='Move a Themis-managed tablet between the Sophy configurations.',
    )
    parser.add_argument('number', nargs='?',
                        help='Device number as shown in the panel (or --all)')
    parser.add_argument('mode', nargs='?',
                        choices=list(MODE_ORDER) + sorted(MODE_ALIASES),
                        help='school / free = "<number>: ..."; lock = "Sophy: Locked"; '
                             'admin = "Sophy: Admin"; unlock = school')
    parser.add_argument('--all', action='store_true',
                        help=f'Apply the mode to every tablet: {", ".join(ALL_DEVICES)}')
    parser.add_argument('--dry-run', action='store_true',
                        help='Resolve everything but do not reassign the device')
    parser.add_argument('--list', action='store_true',
                        help='List configurations on the server and exit')
    parser.add_argument('--status', action='store_true',
                        help='Show the current mode of every tablet and exit')
    args = parser.parse_args()

    try:
        config = env_config()

        if args.list:
            print_configurations(list_configurations(config['THEMIS_URL'], login(config)))
            return

        if args.status:
            print_status(device_states(config['THEMIS_URL'], login(config)))
            return

        if args.all:
            # "--all lock" parses the mode into the number slot.
            mode = args.mode or args.number
            if not mode or args.number and args.mode:
                parser.error('--all takes exactly one mode')
            token = login(config)
            for number in ALL_DEVICES:
                switch(config, number, mode, dry_run=args.dry_run, token=token)
            return

        if not args.number or not args.mode:
            parser.error('number and mode are required unless --list, --status or --all '
                         'is given')

        switch(config, args.number, args.mode, dry_run=args.dry_run)
    except ConfigError as exc:
        print(f'Error: {exc}', file=sys.stderr)
        sys.exit(2)
    except HeadwindError as exc:
        print(f'Error: {exc}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()

#!/usr/bin/env python3
"""Write a shareable copy of a pfSense config.xml with every secret redacted.

The real config.xml holds credentials (the admin password hash, the web GUI
private key, the Dynamic DNS password, the SNMP community, the Netgate device
key) and is gitignored. The repo tracks the redacted copy, config.xml.example,
so the firewall layout stays readable without publishing anything secret.

Redaction works on the raw text, not a parsed tree, so the example keeps the
original formatting and diffs cleanly against the real file.

Usage:
    sanitize-config                  # config.xml -> config.xml.example
    sanitize-config --dry-run        # report what would be redacted
    sanitize-config --check FILE     # exit 1 if FILE still holds a secret
"""

import argparse
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DEFAULT_INPUT = HERE / "config.xml"
DEFAULT_OUTPUT = HERE / "config.xml.example"
PLACEHOLDER = "REDACTED"

# Elements whose text is a secret. Keep in sync with the history scrub's
# replace-text rules if the repo history is ever rewritten again.
SECRET_TAGS = [
    "bcrypt-hash",
    "sha512-hash",
    "password",
    "prv",
    "device_key",
    "rocommunity",
    "rwcommunity",
    "pre-shared-key",
    "privatekey",
    "presharedkey",
    "tls",
    "shared_key",
    "ldap_bindpw",
    "radius_secret",
    "apikey",
]


def _pattern(tag: str) -> re.Pattern[str]:
    """Match a non-empty <tag>…</tag> element, capturing its text."""
    return re.compile(rf"(<{re.escape(tag)}>)(?!{PLACEHOLDER}<)([^<]+)(</{re.escape(tag)}>)")


def find_secrets(text: str) -> dict[str, int]:
    """Count unredacted secret elements by tag."""
    counts = {}
    for tag in SECRET_TAGS:
        found = len(_pattern(tag).findall(text))
        if found:
            counts[tag] = found
    return counts


def redact(text: str) -> str:
    """Replace the text of every secret element with the placeholder."""
    for tag in SECRET_TAGS:
        text = _pattern(tag).sub(rf"\g<1>{PLACEHOLDER}\g<3>", text)
    return text


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--input", type=Path, default=DEFAULT_INPUT, help="real config.xml")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT, help="redacted copy")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="report only; write nothing")
    mode.add_argument("--check", type=Path, metavar="FILE", help="exit 1 if FILE has secrets")
    args = parser.parse_args()

    if args.check:
        leftover = find_secrets(args.check.read_text(encoding="utf-8"))
        if leftover:
            print(f"{args.check} still holds secrets: {leftover}", file=sys.stderr)
            return 1
        print(f"{args.check}: no secrets found")
        return 0

    try:
        text = args.input.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"Error: cannot read {args.input}: {exc}", file=sys.stderr)
        return 2
    found = find_secrets(text)
    if args.dry_run:
        print(f"Would redact {sum(found.values())} elements: {found}")
        return 0

    redacted = redact(text)
    leftover = find_secrets(redacted)
    if leftover:
        print(f"Error: redaction left secrets behind: {leftover}", file=sys.stderr)
        return 1
    args.output.write_text(redacted, encoding="utf-8")
    print(f"Wrote {args.output}: redacted {sum(found.values())} elements {found}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

# /opt/firecrawl/.env — Firecrawl runtime configuration (Ansible-managed)
# Compose-level env substitution; see compose.yaml for defaults.

# API port published on the VM
PORT={{ firecrawl_port }}
INTERNAL_PORT={{ firecrawl_port }}

# Self-hosted: no Supabase auth layer
USE_DB_AUTHENTICATION=false

# Queue admin UI auth (/admin/{key}/queues)
BULL_AUTH_KEY={{ vault_firecrawl_bull_auth_key }}

LOGGING_LEVEL=INFO

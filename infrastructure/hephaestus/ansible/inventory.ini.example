# inventory.ini.example - Ansible Host Inventory
#
# Copy this file to inventory.ini:
#   cp inventory.ini.example inventory.ini
#
# The VM user is 'ubuntu' (cloud-init default; root SSH is disabled on
# Ubuntu cloud images). Privilege escalation via passwordless sudo.

[hephaestus]
hephaestus-01 ansible_host=10.0.50.30 ansible_user=ubuntu ansible_port=22

[hephaestus:vars]
# SSH configuration
ansible_ssh_private_key_file = ~/.ssh/id_rsa
ansible_ssh_common_args = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# Python interpreter
ansible_python_interpreter = /usr/bin/python3

# Connection settings
ansible_connection_timeout = 30

# Privilege escalation
ansible_become = true
ansible_become_user = root
ansible_become_method = sudo

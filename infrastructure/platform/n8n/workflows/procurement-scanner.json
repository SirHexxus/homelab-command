      "name": "Get Procurement Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        672,
        304
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "id": "6c423027-4833-4706-a25e-add7438b1e60"

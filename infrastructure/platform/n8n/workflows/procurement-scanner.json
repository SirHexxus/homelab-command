    {
      "parameters": {
        "jsCode": "const { rows, scanned, kept, truncated, today } = $input.first().json;\nconst day = d => d ? String(d).slice(0, 10) : '?';\n\nlet msg = `🏛 Procurement Scan — ${today}\\n`;\n\nif (!kept) {\n  msg += `\\nNothing new. ${scanned} notices scanned, none were biddable product buys with 7+ days of lead time.`;\n} else {\n  msg += `\\n${kept} new product listing${kept === 1 ? '' : 's'} (of ${scanned} scanned). Soonest deadlines:\\n`;\n  const soonest = [...rows].sort((a, b) => a.response_deadline.localeCompare(b.response_deadline)).slice(0, 5);\n  for (const r of soonest) {\n    msg += `• ${r.title} · ${r.agency.split('.').slice(0, 2).join(' / ')} · due ${day(r.response_deadline)}\\n  ${r.sam_link}\\n`;\n  }\n  msg += '\\n— Pick 1 to price this week.';\n}\n\nif (truncated) msg += `\\n\\n⚠ ${truncated} notices past SAM's 1000-per-request cap were not scanned.`;\n\nreturn [{ json: { summary: msg } }];\n"
      },

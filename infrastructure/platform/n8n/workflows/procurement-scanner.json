    {
      "parameters": {
        "jsCode": "const laDay = d => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(d);\nconst today = new Date(`${laDay(new Date())}T00:00:00Z`);\nconst samDate = daysBack => {\n  const d = new Date(today.getTime() - daysBack * 86400000);\n  const mm = String(d.getUTCMonth() + 1).padStart(2, '0');\n  const dd = String(d.getUTCDate()).padStart(2, '0');\n  return `${mm}/${dd}/${d.getUTCFullYear()}`;\n};\n\n// Two-day window so one rate-limited run self-heals on the next; dedupe absorbs the overlap.\nconst postedFrom = samDate(2);\nconst postedTo = samDate(1);\n\n// One request per notice type: o = Solicitation, k = Combined Synopsis/Solicitation\nreturn ['o', 'k'].map(ptype => ({ json: { ptype, postedFrom, postedTo } }));\n"
      },

    {
      "parameters": {
        "jsCode": "const KEEP_SET_ASIDES = ['', 'SBA', 'SBP'];\nconst MIN_LEAD_DAYS = 7;\nconst PAGE_LIMIT = 1000;\n\nconst laDay = d => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(d);\nconst todayStr = laDay(new Date());\nconst cutoffStr = laDay(new Date(Date.parse(`${todayStr}T12:00:00Z`) + MIN_LEAD_DAYS * 86400000));\nconst isoDay = s => `${s}T00:00:00.000Z`;\n\nconst pages = $('Search SAM.gov').all().map(i => i.json);\nconst seen = new Set($input.all().map(i => i.json.notice_id).filter(Boolean));\n\nlet scanned = 0;\nlet truncated = 0;\nconst rows = [];\nfor (const page of pages) {\n  const opps = page.opportunitiesData || [];\n  scanned += opps.length;\n  if ((page.totalRecords || 0) > PAGE_LIMIT) truncated += page.totalRecords - PAGE_LIMIT;\n  for (const o of opps) {\n    if (!o.noticeId || seen.has(o.noticeId)) continue;\n    if (o.active !== 'Yes') continue;\n    if (!/^[0-9]/.test(o.classificationCode || '')) continue;\n    if (!KEEP_SET_ASIDES.includes(o.typeOfSetAside || o.setAsideCode || '')) continue;\n    if (!o.responseDeadLine) continue;\n    const deadline = new Date(o.responseDeadLine);\n    if (isNaN(deadline) || laDay(deadline) < cutoffStr) continue;\n    seen.add(o.noticeId);\n    rows.push({\n      notice_id: o.noticeId,\n      title: o.title || '',\n      solicitation_number: o.solicitationNumber || '',\n      agency: o.fullParentPathName || '',\n      notice_type: o.type || '',\n      naics: o.naicsCode || '',\n      psc: o.classificationCode || '',\n      set_aside: o.typeOfSetAside || o.setAsideCode || '',\n      posted_date: o.postedDate ? isoDay(String(o.postedDate).slice(0, 10)) : null,\n      response_deadline: deadline.toISOString(),\n      found_date: isoDay(todayStr),\n      sam_link: `https://sam.gov/opp/${o.noticeId}/view`,\n      status: 'New',\n    });\n  }\n}\n\nreturn [{ json: { rows, scanned, kept: rows.length, truncated, today: todayStr } }];\n"
      },

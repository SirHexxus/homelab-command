      "name": "Format Insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "const req = $('Validate & Normalize').first().json;\nconst created = $input.first().json || {};\nconst row = { ...req.row, ...(created.id !== undefined ? { id: created.id } : {}) };\nconst idNote = row.id !== undefined ? ` (row ${row.id})` : '';\nreturn [{ json: { ok: true, message: `Added prospect \"${row.name}\"${idNote} in stage ${row.stage}.`, row } }];"
      }
    },

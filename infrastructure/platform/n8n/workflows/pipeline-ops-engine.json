    {
      "id": "3a5fea0b-6424-475b-a743-e9a9ca2a7c14",
      "name": "Guard & Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "jsCode": "const req = $('Validate & Normalize').first().json;\nconst found = $input.all().map((i) => i.json).filter((r) => r && r.id !== undefined && r.id !== null);\nif (!found.length) {\n  return [{ json: { op: 'error', error: `No pipeline row with id ${req.id}. Call pipeline_list to see current rows.` } }];\n}\nconst row = found[0];\nif (req.op === 'delete') {\n  if (row.stage !== 'Closed Lost') {\n    return [{ json: { op: 'error', error: `Row ${req.id} (\"${row.name}\") is in stage \"${row.stage}\". Deletes are limited to Closed Lost rows.` } }];\n  }\n  return [{ json: { op: 'do_delete', id: req.id, name: row.name } }];\n}\nconst merged = {\n  name: row.name,\n  company: row.company || '',\n  stage: row.stage,\n  next_step: row.next_step || '',\n  next_step_due: row.next_step_due,\n  last_touch: row.last_touch,\n  notes: row.notes || '',\n  ...req.changes,\n};\nreturn [{ json: { op: 'do_update', id: req.id, verb: req.verb, merged } }];"
      }
    },

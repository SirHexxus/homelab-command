      ],
      "parameters": {
        "jsCode": "const g = $('Guard & Merge').first().json;\nconst verbs = { update: 'Updated', touch: 'Touched (last_touch stamped)', close: 'Closed' };\nconst verb = verbs[g.verb] || 'Updated';\nreturn [{ json: { ok: true, message: `${verb} row ${g.id} (\"${g.merged.name}\") — stage: ${g.merged.stage}.`, row: { id: g.id, ...g.merged } } }];"

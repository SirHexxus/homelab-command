    {
      "id": "4e9f89d2-6d54-462b-a390-fae63ae91bb4",
      "name": "Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -300
      ],
      "parameters": {
        "jsCode": "const inc = $('Validate & Normalize').first().json.include_closed === true;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.name);\nconst visible = rows.filter((r) => inc || !String(r.stage || '').startsWith('Closed'));\nconst out = visible.map((r) => ({\n  id: r.id, name: r.name, company: r.company, stage: r.stage,\n  next_step: r.next_step, next_step_due: r.next_step_due, last_touch: r.last_touch, notes: r.notes,\n}));\nreturn [{ json: { ok: true, count: out.length, rows: out } }];"
      }
    },

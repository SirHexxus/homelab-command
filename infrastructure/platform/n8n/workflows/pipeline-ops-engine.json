    {
      "id": "9a413303-2380-47dc-b8e6-0280913e69cd",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const OPEN_STAGES = ['Prospect', 'Meeting Booked', 'Qualified', 'Proposal Sent', 'Decision Pending'];\nconst inp = $input.first().json;\nconst fail = (error) => [{ json: { op: 'error', error } }];\n\nconst laToday = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());\nconst toIsoDate = (s) => {\n  const m = String(s).trim().match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (!m) return null;\n  const iso = `${m[1]}-${m[2]}-${m[3]}`;\n  const d = new Date(`${iso}T00:00:00Z`);\n  if (isNaN(d.getTime()) || d.toISOString().slice(0, 10) !== iso) return null;\n  return `${iso}T00:00:00.000Z`;\n};\nconst str = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\nconst op = str(inp.operation);\nif (!['list', 'add', 'update', 'touch', 'close', 'delete'].includes(op)) {\n  return fail(`Unknown operation \"${op}\".`);\n}\n\nif (op === 'list') {\n  const inc = inp.include_closed === true || inp.include_closed === 'true';\n  return [{ json: { op: 'list', include_closed: inc } }];\n}\n\nif (op === 'add') {\n  const name = str(inp.name);\n  const nextStep = str(inp.next_step);\n  const due = toIsoDate(inp.next_step_due);\n  if (!name) return fail('pipeline_add requires \"name\".');\n  if (!nextStep) return fail('pipeline_add requires \"next_step\" — never add a prospect without a documented next step.');\n  if (!due) return fail(`pipeline_add requires \"next_step_due\" as an ISO date (YYYY-MM-DD); got \"${str(inp.next_step_due)}\".`);\n  const stage = str(inp.stage) || 'Prospect';\n  if (!OPEN_STAGES.includes(stage)) {\n    return fail(`Invalid stage \"${stage}\". pipeline_add allows only: ${OPEN_STAGES.join(', ')}.`);\n  }\n  return [{ json: { op: 'add', row: {\n    name,\n    company: str(inp.company),\n    stage,\n    next_step: nextStep,\n    next_step_due: due,\n    last_touch: `${laToday}T00:00:00.000Z`,\n    notes: str(inp.notes),\n  } } }];\n}\n\nconst id = Number(inp.id);\nif (!Number.isInteger(id) || id <= 0) {\n  return fail(`\"${inp.id}\" is not a valid numeric row id. Call pipeline_list to get row ids.`);\n}\n\nif (op === 'delete') return [{ json: { op: 'delete', id } }];\n\nconst changes = {};\nif (op === 'touch') {\n  changes.last_touch = `${laToday}T00:00:00.000Z`;\n} else if (op === 'close') {\n  const outcome = str(inp.outcome);\n  if (!['Won', 'Lost'].includes(outcome)) {\n    return fail('pipeline_close requires \"outcome\" of exactly \"Won\" or \"Lost\".');\n  }\n  changes.stage = `Closed ${outcome}`;\n} else {\n  const stage = str(inp.stage);\n  if (stage) {\n    if (!OPEN_STAGES.includes(stage)) {\n      return fail(`Invalid stage \"${stage}\". pipeline_update allows only open stages (${OPEN_STAGES.join(', ')}); use pipeline_close for Closed Won/Lost.`);\n    }\n    changes.stage = stage;\n  }\n  const nextStep = str(inp.next_step);\n  if (nextStep) changes.next_step = nextStep;\n  const dueRaw = str(inp.next_step_due);\n  if (dueRaw) {\n    const due = toIsoDate(dueRaw);\n    if (!due) return fail(`\"${dueRaw}\" is not a valid ISO date (YYYY-MM-DD).`);\n    changes.next_step_due = due;\n  }\n  const notes = str(inp.notes);\n  if (notes) changes.notes = notes;\n  if (!Object.keys(changes).length) {\n    return fail('pipeline_update requires at least one of: stage, next_step, next_step_due, notes.');\n  }\n}\nreturn [{ json: { op: 'update', id, changes, verb: op } }];"
      }
    },

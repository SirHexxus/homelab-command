# inventory.ini.example - Ansible Host Inventory
#
# Copy this file to inventory.ini:
#   cp inventory.ini.example inventory.ini
#
# The VM user is 'debian' (Debian cloud-init default; root SSH is disabled on
# Debian cloud images). Privilege escalation via passwordless sudo.
#
# Reachable ONLY from the wired VLAN 10 workstation (10.0.10.68) per the
# pfSense recon rule — run this playbook from that machine.

[recon]
recon-01 ansible_host=10.0.66.10 ansible_user=debian ansible_port=22

[recon:vars]
# SSH configuration
ansible_ssh_private_key_file = ~/.ssh/id_rsa
ansible_ssh_common_args = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# Python interpreter
ansible_python_interpreter = /usr/bin/python3

# Connection settings
ansible_connection_timeout = 30

# Privilege escalation
ansible_become = true
ansible_become_user = root
ansible_become_method = sudo

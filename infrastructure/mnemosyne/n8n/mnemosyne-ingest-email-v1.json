        "jsCode": "const msg = $input.item.json;\nconst subject = msg.subject ?? '';\n\nlet body = msg.text ?? '';\nif (!body && msg.html) {\n  body = String(msg.html).replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\nconst text = [subject ? ('# ' + subject) : null, body].filter(Boolean).join('\\n\\n');\n\nconst messageId = msg.messageId ?? (msg.headers && msg.headers['message-id']) ?? String($execution.id);\nconst dedupKey = 'dedup:email:' + messageId;\n\nconst binKeys = Object.keys($input.item.binary ?? {});\nconst hasAttachment = binKeys.length > 0;\nconst att = hasAttachment ? $input.item.binary[binKeys[0]] : null;\nconst fileName = (att && att.fileName) ? att.fileName : 'attachment';\nconst now = new Date();\nconst fileKey = hasAttachment\n  ? `files/${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${$execution.id}-${fileName}`\n  : null;\n\nconst from = msg.from?.value?.[0]?.address ?? msg.from?.text ?? null;\n\nreturn {\n  json: {\n    _text: text,\n    _dedup_key: dedupKey,\n    _message_id: String(messageId),\n    _has_attachment: hasAttachment,\n    _file_key: fileKey,\n    _subject: subject,\n    _from: from,\n  },\n  binary: hasAttachment ? { data: att } : {},\n};"
      },

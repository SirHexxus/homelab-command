    {
      "parameters": {
        "jsCode": "const nrm = $input.item.json;\nif (nrm._normalized) {\n  const nmsg = $('Telegram Trigger').item.json;\n  let ndk;\n  if (nrm._text) {\n    let h = 5381;\n    const t = nrm._text;\n    for (let i = 0; i < t.length; i++) h = (((h << 5) + h) + t.charCodeAt(i)) >>> 0;\n    ndk = `dedup:${h.toString(16).padStart(8, '0')}`;\n  } else {\n    ndk = `dedup:${nrm._file_ref ?? $execution.id}`;\n  }\n  return [{ json: { ...nmsg, _text: nrm._text ?? null, _file_ref: nrm._file_ref ?? null,\n    _file_refs: nrm._file_refs ?? null, _extraction_modes: nrm._extraction_modes ?? null,\n    _photo_count: nrm._photo_count ?? null, _chat_id: String(nmsg.message.chat.id),\n    _dedup_key: ndk, _raw_content_type: nrm._raw_content_type ?? 'file_ref' } }];\n}\n\nconst msg = $('Telegram Trigger').item.json;\nconst chatId = String(msg.message.chat.id);\nconst isVoice = !!msg.message.voice;\nconst isVideo = !!msg.message.video;\nconst isFile = !!(msg.message.document || msg.message.photo);\nconst caption = msg.message.caption ?? null;\nconst inputJson = $input.item.json;\n\nlet text = null;\nlet fileRef = null;\nlet rawContentType;\nlet dedupKey;\n\nif (isVoice) {\n  text = inputJson.text;\n  rawContentType = 'voice';\n} else if (isVideo) {\n  const transcript = inputJson.text ?? null;\n  text = [caption, transcript].filter(Boolean).join('\\n\\n## Transcript\\n\\n');\n  try { fileRef = $('Build Video Key').item.json._file_key; } catch(e) { fileRef = null; }\n  rawContentType = 'video';\n} else if (msg.message.audio) {\n  const transcript = inputJson.text ?? null;\n  text = [caption, transcript].filter(Boolean).join('\\n\\n## Transcript\\n\\n');\n  rawContentType = 'voice';\n} else if (isFile) {\n  if (inputJson.text || inputJson.data) {\n    text = inputJson.text ?? inputJson.data;\n    rawContentType = 'file_text';\n  } else {\n    try { fileRef = $('Build File Key').item.json._file_key; } catch(e) { fileRef = null; }\n    rawContentType = 'file_ref';\n  }\n  if (caption) text = caption + (text ? '\\n\\n---\\n' + text : '');\n} else {\n  text = msg.message.text;\n  rawContentType = 'text';\n}\n\nif (text) {\n  let h = 5381;\n  for (let i = 0; i < text.length; i++) h = (((h << 5) + h) + text.charCodeAt(i)) >>> 0;\n  dedupKey = `dedup:${h.toString(16).padStart(8, '0')}`;\n} else {\n  const fileId = msg.message.video?.file_id\n    ?? msg.message.document?.file_id\n    ?? msg.message.photo?.[msg.message.photo.length - 1]?.file_id\n    ?? $execution.id;\n  dedupKey = `dedup:${fileId}`;\n}\n\nreturn [{ json: { ...msg, _text: text, _file_ref: fileRef, _chat_id: chatId, _dedup_key: dedupKey, _raw_content_type: rawContentType } }];"
      },

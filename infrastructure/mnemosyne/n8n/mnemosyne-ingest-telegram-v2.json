    {
      "id": "e22925216933-0000-4000-8000-462925216933",
      "name": "Prepare OCR Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2424,
        1508
      ],
      "parameters": {
        "jsCode": "const PROMPT = \"You are processing an image sent to a personal knowledge base. If the image is primarily text (document, screenshot, sign, whiteboard, receipt, handwriting), transcribe ALL text verbatim and set mode to \\\"ocr\\\". Otherwise set mode to \\\"description\\\" and write a concise 2-4 sentence description of the image contents.\";\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let b64 = null;\n  try {\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    b64 = buf.toString('base64');\n  } catch (e) { b64 = null; }\n  const mime = item.binary?.data?.mimeType ?? 'image/jpeg';\n  const body = b64 ? {\n    contents: [{ role: 'user', parts: [\n      { text: PROMPT },\n      { inlineData: { mimeType: mime, data: b64 } },\n    ]}],\n    generationConfig: {\n      responseMimeType: 'application/json',\n      responseSchema: {\n        type: 'OBJECT',\n        properties: { mode: { type: 'STRING', enum: ['ocr', 'description'] }, text: { type: 'STRING' } },\n        required: ['mode', 'text'],\n      },\n      temperature: 0,\n    },\n  } : null;\n  out.push({ json: { ...item.json, ocr_body: body } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "e28896059327-0000-4000-8000-318896059327",
      "name": "Vertex OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2644,
        1508
      ],
      "parameters": {
        "method": "POST",
        "url": "https://us-central1-aiplatform.googleapis.com/v1/projects/gen-lang-client-0234750661/locations/us-central1/publishers/google/models/gemini-2.5-flash-lite:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ocr_body) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "googleApi": {
          "id": "Z4FVeynwn8eRoNUQ",
          "name": "Google Service Account account"
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "e20058019964-0000-4000-8000-680058019964",
      "name": "Normalize Photos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2864,
        1508
      ],
      "parameters": {
        "jsCode": "const prepped = $('Prepare OCR Payload').all().map(i => i.json);\nconst resp = $input.all().map(i => i.json);\nconst caption = prepped[0]?.caption ?? null;\nconst sections = [];\nconst fileRefs = [];\nconst modes = [];\nfor (let i = 0; i < prepped.length; i++) {\n  const key = prepped[i]._file_key ?? null;\n  if (key) fileRefs.push(key);\n  let mode = 'failed';\n  let text = null;\n  const rawText = resp[i]?.candidates?.[0]?.content?.parts?.[0]?.text;\n  if (rawText) {\n    try { const p = JSON.parse(rawText); mode = p.mode ?? 'ocr'; text = p.text ?? null; }\n    catch (e) { mode = 'ocr'; text = rawText; }\n  }\n  modes.push(mode);\n  const label = mode === 'description' ? 'Image description' : (mode === 'ocr' ? 'OCR' : 'Extraction failed');\n  const header = prepped.length > 1 ? `Photo ${i + 1} — ${label}` : label;\n  sections.push(text ? `## ${header}\\n\\n${text}` : `## ${header}\\n\\n(no text extracted)`);\n}\nconst bodyText = [caption, ...sections].filter(Boolean).join('\\n\\n');\nreturn [{ json: {\n  _normalized: true,\n  _text: bodyText || null,\n  _file_ref: fileRefs[0] ?? null,\n  _file_refs: fileRefs,\n  _extraction_modes: modes,\n  _photo_count: prepped.length,\n  _raw_content_type: fileRefs.length ? 'file_ref' : 'text',\n} }];\n"
      }
    },

      "parameters": {
        "jsCode": "const prev = $('Build Dedup Hash').item.json;\nreturn [{ json: {\n  workflow: 'mnemosyne',\n  task: 'ingest',\n  payload: {\n    raw_content_type: prev._raw_content_type || 'text',\n    source: 'telegram',\n    text: prev._text,\n    file_ref: prev._file_ref,\n    metadata: { chat_id: prev._chat_id },\n    bucket_hint: null\n  },\n  context_name: 'personal',\n  _text: prev._text,\n  _chat_id: prev._chat_id,\n  _dedup_key: prev._dedup_key,\n  _dedup_ttl: 86400\n} }];"

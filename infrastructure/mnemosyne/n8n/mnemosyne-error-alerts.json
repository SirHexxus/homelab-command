    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// n8n sends two different shapes: run-time failures carry `execution`,\n// trigger-activation failures carry `trigger` instead. Flatten both.\nconst j = $input.item.json;\nconst ex = j.execution;\nconst tr = j.trigger;\nconst isTriggerError = !ex && !!tr;\nconst wf = j.workflow ?? {};\nconst base = 'https://automation.hexxusweb.com/workflow/' + (wf.id ?? '');\n\nreturn {\n  json: {\n    isTriggerError,\n    kind: isTriggerError ? 'Trigger Problem' : 'Workflow Failed',\n    wfName: wf.name ?? 'unknown',\n    wfId: wf.id ?? '',\n    node: ex?.lastNodeExecuted ?? 'n/a (trigger activation)',\n    message: ex?.error?.message ?? tr?.error?.message ?? 'unknown',\n    mode: ex?.mode ?? tr?.mode ?? 'unknown',\n    link: ex?.id ? base + '/executions/' + ex.id : base,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "1b7c0a54-2f61-4d8e-9a03-5c81e6d4f210",
      "name": "Normalize Error"
    },
    {

#!/usr/bin/env python3
"""Generate and send the Mnemosyne daily digest via Telegram.

Implements the 5-category content model defined in
`reference/Mnemosyne Retrieval Architecture.md`:

  1. Temporal anchors  (birthdays, anniversaries, weather, location)
  2. Obligations       (ADMIN due/overdue, PERSON follow-ups)
  3. Forward-prep      (upcoming items, calendar block — calendar TODO)
  4. Unfinished thoughts  (conditional — omit if empty)
  5. Stale-but-now-relevant  (conditional — omit if empty; Layer 3 TODO)

Layer separation: this script (Layer 2) collects, filters, and structures
the inputs. The Layer 4 Gemini call performs selection, prioritization, and
voice rendering only — no file discovery, no status parsing, no inference
about state.

Prompts live in `prompts/daily-digest-system.md` and
`prompts/daily-digest-user.md`. The system file is sent as Gemini's
`system_instruction`; the user file is run through `str.format()` with the
collected inputs.

Usage:
  daily-digest                    # generate, write report, send via Telegram
  daily-digest --dry-run          # print collected data without calling Gemini
  daily-digest --no-send          # generate report, skip Telegram delivery
  daily-digest --wiki-root DIR    # wiki root directory (default: ~/mneme/wiki)
  daily-digest --lookahead N      # forward-prep window in days (default: 3)
  daily-digest --system-prompt P  # override default system prompt path (A/B)
  daily-digest --user-prompt P    # override default user prompt path (A/B)
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import textwrap
from datetime import date, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from gcal import fetch_calendar  # noqa: E402
from weather import fetch_weather  # noqa: E402


# ── Constants ────────────────────────────────────────────────────────────────

DEFAULT_WIKI_ROOT = Path.home() / "mneme" / "wiki"
GEMINI_MODEL = "gemini-3.5-flash"
# Per-run token usage is appended here as JSONL — one record per generation.
# Lives outside the wiki git repo: operational telemetry, not knowledge.
TOKEN_LOG = Path.home() / "mneme" / "logs" / "digest-tokens.jsonl"
DEFAULT_LOOKAHEAD = 3
PERSON_LOOKAHEAD_DAYS = 14
BIRTHDAY_LOOKAHEAD_DAYS = 7

# Prompt files live next to this script. Override via --system-prompt /
# --user-prompt for A/B testing.
_SCRIPT_DIR = Path(__file__).resolve().parent
DEFAULT_SYSTEM_PROMPT_PATH = _SCRIPT_DIR / "prompts" / "daily-digest-system.md"
DEFAULT_USER_PROMPT_PATH = _SCRIPT_DIR / "prompts" / "daily-digest-user.md"

# James's events are split across two calendars: personal items on the
# primary calendar, family events (church, game night, kids' activities) on
# the shared "Stacy Family Calendar". The digest pulls from both.
CALENDAR_IDS = (
    "primary",
    "e31e49958e21a3383c4ffaa015f0e27369d6d5c771a7e3f20573bcb38d709af4"
    "@group.calendar.google.com",
)

# Any of these in `status:` means the ADMIN task is closed (hidden).
CLOSED_STATUSES = {"Done", "Completed", "Closed", "Cancelled", "Skipped"}

# Unfinished-thought detection thresholds (see Daily Digest Design Spec).
UNFINISHED_AGE_DAYS = 7
UNFINISHED_WORD_THRESHOLD = 150

# Sentinel passed to the LLM prompt for empty sections; explicit instruction
# in the system prompt tells the model to drop the section silently and never
# echo this token. Keep in sync with prompts/daily-digest-system.md.
OMIT = "[[OMIT_SECTION]]"

# Gemini credentials. Path resolves from GEMINI_CREDENTIALS env var (set in
# ~/.bashrc.local for interactive shells and cron) or falls back to the
# default below. File holds {"api_key": "...", "model": "..."}; the model
# field is optional and falls back to GEMINI_MODEL above.
DEFAULT_GEMINI_CREDS_PATH = Path.home() / ".config" / "mnemosyne" / "gemini-creds.json"


# ── Frontmatter & body parsing ───────────────────────────────────────────────

def split_frontmatter(path: Path) -> tuple[dict[str, str], str]:
    """Return (frontmatter_dict, body_text). Empty dict/string on failure."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return {}, ""
    if not text.startswith("---"):
        return {}, text
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}, text
    fm: dict[str, str] = {}
    for line in parts[1].splitlines():
        if ":" not in line:
            continue
        key, _, val = line.partition(":")
        fm[key.strip()] = val.strip()
    return fm, parts[2]


def parse_frontmatter(path: Path) -> dict[str, str]:
    """Frontmatter-only convenience wrapper."""
    return split_frontmatter(path)[0]


def word_count(body: str) -> int:
    """Crude but adequate: whitespace-split count, no markdown stripping."""
    return len(body.split())


def weekday_name(iso: str) -> str:
    """Weekday name for an ISO date string. Empty string on parse failure."""
    try:
        return date.fromisoformat(iso).strftime("%A")
    except (ValueError, TypeError):
        return ""


BODY_EXCERPT_LIMIT = 1500


def body_excerpt(body: str, limit: int = BODY_EXCERPT_LIMIT) -> str:
    """Trimmed page body, truncated on a line boundary if over `limit`."""
    stripped = body.strip()
    if len(stripped) <= limit:
        return stripped
    return stripped[:limit].rsplit("\n", 1)[0].rstrip() + " […]"


# ── Collectors — obligations ─────────────────────────────────────────────────

def collect_due_tasks(
    wiki_root: Path,
    today: date,
    lookahead: int,
) -> dict[str, list[dict[str, str]]]:
    """ADMIN tasks split into overdue, due-today, and upcoming buckets."""
    cutoff = today + timedelta(days=lookahead)
    overdue: list[dict[str, str]] = []
    due_today: list[dict[str, str]] = []
    upcoming: list[dict[str, str]] = []

    for md_file in sorted((wiki_root / "admin").glob("*.md")):
        fm, body = split_frontmatter(md_file)
        if fm.get("status") in CLOSED_STATUSES:
            continue
        raw_due = fm.get("due", "")
        if not raw_due or raw_due == "null":
            continue
        try:
            due_date = date.fromisoformat(raw_due)
        except ValueError:
            continue

        entry = {
            "title": md_file.stem,
            "due": raw_due,
            "weekday": weekday_name(raw_due),
            "task_type": fm.get("task_type", "user"),
            "body": body_excerpt(body),
        }
        if due_date < today:
            overdue.append(entry)
        elif due_date == today:
            due_today.append(entry)
        elif due_date <= cutoff:
            upcoming.append(entry)

    return {"overdue": overdue, "due_today": due_today, "upcoming": upcoming}


def collect_follow_ups(wiki_root: Path, today: date) -> list[dict[str, str]]:
    """PERSON pages flagged for follow-up within the person-lookahead window."""
    cutoff = today + timedelta(days=PERSON_LOOKAHEAD_DAYS)
    follow_ups: list[dict[str, str]] = []

    for md_file in sorted((wiki_root / "people").glob("*.md")):
        fm, body = split_frontmatter(md_file)
        if fm.get("follow_up_needed", "").lower() != "true":
            continue
        raw_date = fm.get("follow_up_date", "")
        if not raw_date or raw_date == "null":
            follow_ups.append({
                "title": md_file.stem,
                "follow_up_date": "(no date set)",
                "weekday": "",
                "body": body_excerpt(body),
            })
            continue
        try:
            fu_date = date.fromisoformat(raw_date)
        except ValueError:
            continue
        if fu_date <= cutoff:
            follow_ups.append({
                "title": md_file.stem,
                "follow_up_date": raw_date,
                "weekday": weekday_name(raw_date),
                "body": body_excerpt(body),
            })

    return follow_ups


# ── Collectors — temporal anchors ────────────────────────────────────────────

def collect_birthdays(wiki_root: Path, today: date) -> list[dict[str, str]]:
    """PERSON pages with `birthday:` falling in the lookahead window.

    Birthdays may be stored as YYYY-MM-DD or MM-DD (year-agnostic). Both
    are handled. Pages without a birthday field are skipped silently —
    the field is optional in the schema.
    """
    matches: list[dict[str, str]] = []
    horizon = today + timedelta(days=BIRTHDAY_LOOKAHEAD_DAYS)

    for md_file in sorted((wiki_root / "people").glob("*.md")):
        fm = parse_frontmatter(md_file)
        raw = fm.get("birthday", "")
        if not raw or raw == "null":
            continue
        try:
            if len(raw) == 5:  # MM-DD
                month, day = (int(p) for p in raw.split("-"))
                bday_this_year = date(today.year, month, day)
            else:
                parsed = date.fromisoformat(raw)
                bday_this_year = date(today.year, parsed.month, parsed.day)
        except (ValueError, TypeError):
            continue

        # Check this year and next year (handles year-end wrap).
        next_year_bday = date(
            today.year + 1, bday_this_year.month, bday_this_year.day
        )
        for occurrence in (bday_this_year, next_year_bday):
            if today <= occurrence <= horizon:
                matches.append({
                    "title": md_file.stem,
                    "date": occurrence.isoformat(),
                    "is_today": "true" if occurrence == today else "false",
                })
                break

    return matches


def fetch_weather_block() -> dict | None:
    """Read env-var config and call the weather library. None on any gap."""
    api_key = os.environ.get("OPENWEATHER_API_KEY", "").strip()
    raw_lat = os.environ.get("WEATHER_LAT", "").strip()
    raw_lon = os.environ.get("WEATHER_LON", "").strip()
    if not (api_key and raw_lat and raw_lon):
        return None
    try:
        lat = float(raw_lat)
        lon = float(raw_lon)
    except ValueError:
        return None
    return fetch_weather(lat, lon, api_key)


# ── Collectors — yesterday's captures ────────────────────────────────────────

def collect_yesterday_log(wiki_root: Path, yesterday: date) -> list[str]:
    """log.md lines for yesterday — real captures only.

    `report` rows (maintenance-script output and the digest's own
    self-referential entries) are dropped, and identical lines are
    de-duplicated, so the model weaves genuine activity rather than noise.
    """
    log_path = wiki_root / "log.md"
    prefix = yesterday.isoformat()
    try:
        lines = log_path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []

    captures: list[str] = []
    seen: set[str] = set()
    for line in lines:
        if not line.startswith(prefix):
            continue
        fields = [f.strip() for f in line.split("|")]
        if len(fields) > 1 and fields[1] == "report":
            continue
        if line in seen:
            continue
        seen.add(line)
        captures.append(line)
    return captures


# ── Collectors — unfinished thoughts ─────────────────────────────────────────

def collect_unfinished_thoughts(wiki_root: Path, today: date) -> list[dict[str, str]]:
    """IDEA pages qualifying as unfinished by any of three criteria.

    Criteria (any one triggers inclusion):
      - updated > UNFINISHED_AGE_DAYS ago AND body words < threshold
      - frontmatter `tags:` includes 'unfinished'
      - frontmatter `status: draft`
    """
    cutoff = today - timedelta(days=UNFINISHED_AGE_DAYS)
    matches: list[dict[str, str]] = []

    for md_file in sorted((wiki_root / "ideas").glob("*.md")):
        fm, body = split_frontmatter(md_file)
        if not fm:
            continue

        # Skip tombstones: pages already merged elsewhere are not unfinished.
        if "merged" in fm.get("tags", "").lower():
            continue

        reasons: list[str] = []

        if fm.get("status", "").lower() == "draft":
            reasons.append("status: draft")

        tags_raw = fm.get("tags", "")
        if "unfinished" in tags_raw.lower():
            reasons.append("tagged unfinished")

        raw_updated = fm.get("updated", "")
        wc = word_count(body)
        if raw_updated and raw_updated != "null":
            try:
                updated = date.fromisoformat(raw_updated)
                if updated <= cutoff and wc < UNFINISHED_WORD_THRESHOLD:
                    reasons.append(f"stale & thin ({wc} words, updated {raw_updated})")
            except ValueError:
                pass

        if reasons:
            matches.append({
                "title": md_file.stem,
                "updated": raw_updated or "(unknown)",
                "word_count": str(wc),
                "reason": "; ".join(reasons),
            })

    return matches


# ── Collectors — stubs (deferred to later builds) ────────────────────────────

def collect_stale_relevant() -> None:
    """Stale-but-now-relevant detection.

    Requires Layer 3 (nomic-embed-text) semantic overlap. Deferred. See ADMIN
    task `Wire Stale-But-Now-Relevant Detection into Daily Digest`. Returns
    None so the formatter renders OMIT and the prompt drops the section.
    """
    return None


def fetch_calendar_block(today: date) -> list[dict] | None:
    """Today's events across James's Google Calendars. None on any gap.

    Credentials live in a git-ignored JSON file whose path is given by the
    GOOGLE_CALENDAR_CREDENTIALS env var (set in ~/.bashrc.local, consistent
    with OPENWEATHER_API_KEY). The file holds the OAuth client_id,
    client_secret, and refresh_token.
    """
    creds_path = os.environ.get("GOOGLE_CALENDAR_CREDENTIALS", "").strip()
    if not creds_path:
        return None
    try:
        creds = json.loads(Path(creds_path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return fetch_calendar(
        creds.get("client_id", ""),
        creds.get("client_secret", ""),
        creds.get("refresh_token", ""),
        CALENDAR_IDS,
        today,
    )


# ── Formatters ───────────────────────────────────────────────────────────────

def _format_task(task: dict[str, str]) -> str:
    weekday = task.get("weekday", "")
    when = f"{task['due']} ({weekday})" if weekday else task["due"]
    line = f"- {task['title']} — due {when}, {task['task_type']}"
    body = task.get("body", "").strip()
    if body:
        line += "\n" + textwrap.indent(body, "    ")
    return line


def _format_task_list(tasks: list[dict[str, str]]) -> str:
    if not tasks:
        return ""
    return "\n".join(_format_task(t) for t in tasks)


def format_temporal_anchors(
    today: date,
    weekday: str,
    birthdays: list[dict[str, str]],
    weather: dict | None,
    calendar: list[dict] | None,
) -> str:
    """Section 1 — temporal anchors. Empty → OMIT."""
    lines: list[str] = [f"Date: {weekday}, {today.isoformat()}"]

    if weather:
        lines.append(
            f"Weather (current): {weather['description']}, "
            f"{weather['temp_f']}°F (feels like {weather['feels_like_f']}°F), "
            f"wind {weather['wind_mph']} mph, visibility {weather['visibility']}. "
            f"Sunrise {weather['sunrise']}, sunset {weather['sunset']}."
        )
        if weather.get("source") == "3.0":
            summary = weather.get("forecast_summary", "").strip()
            summary_prefix = f"{summary} " if summary else ""
            lines.append(
                f"Weather (today): {summary_prefix}"
                f"High {weather['high_f']}°F / low {weather['low_f']}°F, "
                f"morning {weather['morn_f']}°F / evening {weather['eve_f']}°F. "
                f"Chance of precipitation {weather['pop_percent']}%."
            )
        else:
            lines.append(
                f"Weather (today): high {weather['high_f']}°F / "
                f"low {weather['low_f']}°F."
            )

    if calendar:
        lines.append("Calendar events today:")
        for ev in calendar:
            location = ev["location"]
            loc = f" (at {location})" if location else ""
            if ev["ongoing"]:
                lines.append(f"- {ev['title']} — ongoing today{loc}")
            elif ev["all_day"]:
                lines.append(f"- {ev['title']} — all day{loc}")
            else:
                lines.append(f"- {ev['title']} — {ev['start']}–{ev['end']}{loc}")

    if birthdays:
        lines.append("Birthdays in the next week:")
        for b in birthdays:
            tag = " (TODAY)" if b["is_today"] == "true" else ""
            lines.append(f"- {b['title']} — {b['date']}{tag}")
    else:
        lines.append("Birthdays in the next week: none.")

    # Section is "always present" by category but the omission rule still wins
    # if there is truly nothing of substance. Date + weekday alone is content
    # enough to anchor the day, so this section is never OMIT in practice.
    return "\n".join(lines)


def format_obligations(
    overdue: list[dict[str, str]],
    due_today: list[dict[str, str]],
    follow_ups: list[dict[str, str]],
) -> str:
    """Section 2 — obligations. Empty → OMIT."""
    if not (overdue or due_today or follow_ups):
        return OMIT
    parts: list[str] = []
    if overdue:
        parts.append("Overdue ADMIN tasks (past due — needs attention):")
        parts.append(_format_task_list(overdue))
    if due_today:
        parts.append("Due today:")
        parts.append(_format_task_list(due_today))
    if follow_ups:
        parts.append("PERSON follow-ups:")
        for fu in follow_ups:
            weekday = fu.get("weekday", "")
            when = fu["follow_up_date"]
            if weekday:
                when = f"{when} ({weekday})"
            parts.append(f"- {fu['title']} (follow-up: {when})")
            body = fu.get("body", "").strip()
            if body:
                parts.append(textwrap.indent(body, "    "))
    return "\n".join(parts)


def format_forward_prep(
    upcoming: list[dict[str, str]],
    lookahead: int,
) -> str:
    """Section 3 — forward-prep. Empty → OMIT."""
    if not upcoming:
        return OMIT
    return f"Upcoming ADMIN tasks (next {lookahead} days):\n" + _format_task_list(upcoming)


def format_unfinished(items: list[dict[str, str]]) -> str:
    """Section 4 — unfinished thoughts. CONDITIONAL — empty → OMIT."""
    if not items:
        return OMIT
    lines: list[str] = []
    for item in items:
        lines.append(
            f"- {item['title']} — {item['reason']}"
        )
    return "\n".join(lines)


def format_stale_relevant(items: None) -> str:
    """Section 5 — stale-but-now-relevant. CONDITIONAL — empty → OMIT.

    Currently always OMIT until Layer 3 detection is wired.
    """
    return OMIT


def format_yesterday_log(lines: list[str]) -> str:
    """Yesterday's captures — context for the model, not its own section.

    Included in every digest as background colour even though it isn't one of
    the five canonical sections. The prompt instructs the model to weave this
    into the closing or fold into an existing section, not to render it as a
    bullet-dump.
    """
    if not lines:
        return OMIT
    return "\n".join(lines)


# ── Prompt loading ───────────────────────────────────────────────────────────

def load_prompt_file(path: Path) -> str:
    """Read a prompt file and return its contents. Exits on failure.

    The system and user prompt files are required — a missing or unreadable
    file is a configuration error, not something to paper over with defaults.
    """
    try:
        return path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"Error: cannot read prompt file {path}: {exc}", file=sys.stderr)
        sys.exit(1)


def build_user_prompt(
    template: str,
    today: date,
    weekday: str,
    weather: dict | None,
    calendar: list[dict] | None,
    birthdays: list[dict[str, str]],
    overdue: list[dict[str, str]],
    due_today: list[dict[str, str]],
    follow_ups: list[dict[str, str]],
    upcoming: list[dict[str, str]],
    unfinished: list[dict[str, str]],
    yesterday_log: list[str],
    lookahead: int,
) -> str:
    """Fill the user-prompt template with today's collected inputs."""
    yesterday = today - timedelta(days=1)
    return template.format(
        temporal_anchors=format_temporal_anchors(today, weekday, birthdays, weather, calendar),
        obligations=format_obligations(overdue, due_today, follow_ups),
        forward_prep=format_forward_prep(upcoming, lookahead),
        unfinished=format_unfinished(unfinished),
        stale_relevant=format_stale_relevant(None),
        yesterday_log=format_yesterday_log(yesterday_log),
        yesterday=yesterday.isoformat(),
    )


# ── Credentials ──────────────────────────────────────────────────────────────

def load_gemini_creds() -> tuple[str, str | None]:
    """Return (api_key, model_or_none) from the Gemini creds JSON.

    Path resolves from GEMINI_CREDENTIALS env var, then DEFAULT_GEMINI_CREDS_PATH.
    A missing file or missing api_key is fatal. Missing model is fine — the
    caller falls back to GEMINI_MODEL.
    """
    raw_path = os.environ.get("GEMINI_CREDENTIALS", "").strip()
    creds_path = Path(raw_path) if raw_path else DEFAULT_GEMINI_CREDS_PATH
    try:
        creds = json.loads(creds_path.read_text(encoding="utf-8"))
    except OSError as exc:
        print(
            f"Error: cannot read Gemini creds at {creds_path}: {exc}",
            file=sys.stderr,
        )
        sys.exit(1)
    except json.JSONDecodeError as exc:
        print(
            f"Error: Gemini creds at {creds_path} is not valid JSON: {exc}",
            file=sys.stderr,
        )
        sys.exit(1)
    api_key = (creds.get("api_key") or "").strip()
    if not api_key:
        print(
            f"Error: Gemini creds at {creds_path} has no 'api_key' field.",
            file=sys.stderr,
        )
        sys.exit(1)
    model = (creds.get("model") or "").strip() or None
    return api_key, model


# ── Output ───────────────────────────────────────────────────────────────────

def write_report(wiki_root: Path, today: date, digest_text: str) -> Path:
    """Write the digest to wiki/reports/ and return the path."""
    reports_dir = wiki_root / "reports"
    reports_dir.mkdir(exist_ok=True)
    report_path = reports_dir / f"daily-digest-{today.isoformat()}.md"
    report_path.write_text(
        f"# Daily Digest — {today.isoformat()}\n\n{digest_text}\n",
        encoding="utf-8",
    )
    return report_path


def append_log(wiki_root: Path, today: date) -> None:
    """Append a report entry to log.md."""
    log_path = wiki_root / "log.md"
    entry = (
        f"{today.isoformat()}T07:00:00Z | report | — "
        f"| Daily Digest — {today.isoformat()} | daily-digest\n"
    )
    try:
        with log_path.open("a", encoding="utf-8") as fh:
            fh.write(entry)
    except OSError as exc:
        print(f"Warning: could not append to log.md: {exc}", file=sys.stderr)


def log_token_usage(today: date, model: str, usage_metadata) -> None:
    """Append a per-run token-usage record to the JSONL token log.

    `usage_metadata` is the Gemini response's UsageMetadata object (or None
    on the rare API path that omits it). Non-fatal on failure — a missing
    telemetry line must never block the digest itself.
    """
    prompt_tokens = getattr(usage_metadata, "prompt_token_count", 0) or 0
    output_tokens = getattr(usage_metadata, "candidates_token_count", 0) or 0
    total_tokens = getattr(usage_metadata, "total_token_count", 0) or 0
    record = {
        "date": today.isoformat(),
        "model": model,
        "prompt_tokens": prompt_tokens,
        "output_tokens": output_tokens,
        "total_tokens": total_tokens,
    }
    try:
        TOKEN_LOG.parent.mkdir(parents=True, exist_ok=True)
        with TOKEN_LOG.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
    except OSError as exc:
        print(f"Warning: could not write token log: {exc}", file=sys.stderr)


def send_telegram(digest_text: str) -> bool:
    """Send the digest via telegram-send. Returns True on success."""
    result = subprocess.run(
        [str(Path.home() / ".local" / "bin" / "telegram-send"), digest_text],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(
            f"Warning: telegram-send exited {result.returncode}: {result.stderr.strip()}",
            file=sys.stderr,
        )
        return False
    return True


def send_voice(digest_text: str) -> None:
    """Render and send the digest as a Telegram voice note. Non-fatal on failure."""
    renderer = Path(__file__).resolve().parent / "render-digest-voice"
    if not renderer.exists():
        print(f"Warning: render-digest-voice not found at {renderer}", file=sys.stderr)
        return
    result = subprocess.run(
        [str(renderer)],
        input=digest_text,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(
            f"Warning: voice render failed (exit {result.returncode}): "
            f"{result.stderr.strip()}",
            file=sys.stderr,
        )
    else:
        print(result.stderr.strip(), file=sys.stderr)


# ── Entry point ──────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--wiki-root", type=Path, default=DEFAULT_WIKI_ROOT, metavar="DIR",
        help=f"Wiki root directory (default: {DEFAULT_WIKI_ROOT})",
    )
    parser.add_argument(
        "--lookahead", type=int, default=DEFAULT_LOOKAHEAD, metavar="N",
        help=f"Forward-prep window in days (default: {DEFAULT_LOOKAHEAD})",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Print collected data without calling claude or sending",
    )
    parser.add_argument(
        "--no-send", action="store_true",
        help="Generate the report but skip Telegram delivery",
    )
    parser.add_argument(
        "--no-voice", action="store_true",
        help="Skip the follow-up Telegram voice note after text delivery",
    )
    parser.add_argument(
        "--system-prompt", type=Path, default=DEFAULT_SYSTEM_PROMPT_PATH, metavar="PATH",
        help=f"System prompt file (default: {DEFAULT_SYSTEM_PROMPT_PATH})",
    )
    parser.add_argument(
        "--user-prompt", type=Path, default=DEFAULT_USER_PROMPT_PATH, metavar="PATH",
        help=f"User prompt template file (default: {DEFAULT_USER_PROMPT_PATH})",
    )
    parser.add_argument(
        "--model", type=str, default=None, metavar="NAME",
        help="Override Gemini model from creds file (e.g. gemini-3.5-pro)",
    )
    args = parser.parse_args()

    wiki_root: Path = args.wiki_root
    if not wiki_root.exists():
        print(f"Error: wiki root not found: {wiki_root}", file=sys.stderr)
        sys.exit(1)

    today = date.today()
    yesterday = today - timedelta(days=1)
    weekday = today.strftime("%A")

    tasks = collect_due_tasks(wiki_root, today, args.lookahead)
    follow_ups = collect_follow_ups(wiki_root, today)
    birthdays = collect_birthdays(wiki_root, today)
    unfinished = collect_unfinished_thoughts(wiki_root, today)
    weather = fetch_weather_block()
    calendar = fetch_calendar_block(today)
    yesterday_log = collect_yesterday_log(wiki_root, yesterday)

    if args.dry_run:
        print(f"[dry-run] Date: {today} ({weekday})")
        print(f"[dry-run] Weather: {weather if weather else '(none)'}")
        if calendar is None:
            print("[dry-run] Calendar: (unavailable)")
        else:
            print(f"[dry-run] Calendar ({len(calendar)}): {[e['title'] for e in calendar]}")
        print(f"[dry-run] Birthdays ({len(birthdays)}): {[b['title'] for b in birthdays]}")
        overdue_titles = [t["title"] for t in tasks["overdue"]]
        due_today_titles = [t["title"] for t in tasks["due_today"]]
        upcoming_titles = [t["title"] for t in tasks["upcoming"]]
        print(f"[dry-run] Overdue ({len(overdue_titles)}): {overdue_titles}")
        print(f"[dry-run] Due today ({len(due_today_titles)}): {due_today_titles}")
        print(f"[dry-run] Upcoming ({len(upcoming_titles)}): {upcoming_titles}")
        print(f"[dry-run] Follow-ups ({len(follow_ups)}): {[f['title'] for f in follow_ups]}")
        print(f"[dry-run] Unfinished thoughts ({len(unfinished)}):")
        for u in unfinished:
            print(f"  - {u['title']} | {u['reason']}")
        print(f"[dry-run] Yesterday log lines ({len(yesterday_log)}):")
        for line in yesterday_log:
            print(f"  {line}")
        return

    system_prompt = load_prompt_file(args.system_prompt)
    user_template = load_prompt_file(args.user_prompt)
    user_prompt = build_user_prompt(
        user_template,
        today=today,
        weekday=weekday,
        weather=weather,
        calendar=calendar,
        birthdays=birthdays,
        overdue=tasks["overdue"],
        due_today=tasks["due_today"],
        follow_ups=follow_ups,
        upcoming=tasks["upcoming"],
        unfinished=unfinished,
        yesterday_log=yesterday_log,
        lookahead=args.lookahead,
    )

    api_key, creds_model = load_gemini_creds()
    model = args.model or creds_model or GEMINI_MODEL

    try:
        from google import genai
        from google.genai import types
    except ImportError as exc:
        print(
            f"Error: google-genai is not installed ({exc}). "
            "Install with: pip install google-genai",
            file=sys.stderr,
        )
        sys.exit(1)

    print(f"Generating digest for {today} via {model}...", file=sys.stderr)
    try:
        client = genai.Client(api_key=api_key)
        response = client.models.generate_content(
            model=model,
            contents=user_prompt,
            config=types.GenerateContentConfig(system_instruction=system_prompt),
        )
    except Exception as exc:
        print(f"Error: Gemini request failed: {exc}", file=sys.stderr)
        sys.exit(1)

    digest_text = (response.text or "").strip()
    if not digest_text:
        print("Error: Gemini returned empty output", file=sys.stderr)
        sys.exit(1)

    usage_metadata = getattr(response, "usage_metadata", None)
    log_token_usage(today, model, usage_metadata)
    if usage_metadata is not None:
        print(
            f"Tokens — prompt: {getattr(usage_metadata, 'prompt_token_count', 0)}, "
            f"output: {getattr(usage_metadata, 'candidates_token_count', 0)}, "
            f"total: {getattr(usage_metadata, 'total_token_count', 0)}",
            file=sys.stderr,
        )

    report_path = write_report(wiki_root, today, digest_text)
    append_log(wiki_root, today)
    print(f"Report written: {report_path}", file=sys.stderr)

    if args.no_send:
        print("Skipping Telegram delivery (--no-send).", file=sys.stderr)
        print(digest_text)
        return

    print("Sending via Telegram...", file=sys.stderr)
    if not send_telegram(digest_text):
        print("Telegram delivery failed — report still written.", file=sys.stderr)
        sys.exit(1)
    print("Sent.", file=sys.stderr)

    if not args.no_voice:
        send_voice(digest_text)


if __name__ == "__main__":
    main()

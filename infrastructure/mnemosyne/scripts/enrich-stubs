#!/usr/bin/env python3
"""Enrich stub wiki pages: merge candidates, expand content, add wikilinks, flag issues.

Finds all [STUB] entries in index.md and processes each with claude sonnet.
Run on a periodic schedule (every 6 hours via cron).

Usage:
  enrich-stubs                        # process all [STUB] entries in index.md
  enrich-stubs --page "Page Title"    # enrich a single stub by title
  enrich-stubs --dry-run              # list stubs found, do not call claude
  enrich-stubs --fact-check-age N     # stale REFERENCE threshold in days (default: 730)
  enrich-stubs --wiki-root DIR        # wiki root directory (default: ~/mneme/wiki)
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


# ── Constants ─────────────────────────────────────────────────────────────────

DEFAULT_WIKI_ROOT = Path.home() / "mneme" / "wiki"
SCHEMA_FILENAME = "SCHEMA.md"
INDEX_FILENAME = "index.md"
SONNET_MODEL = "claude-sonnet-4-6"
DEFAULT_FACT_CHECK_AGE = 730

# Throttle: cap how many stubs a single run / a single UTC day may enrich, so the
# cron can never spike the subscription session budget it shares with James's
# interactive use. 0 = unlimited. See the cap justification in DRIVE-INGEST-PLAN.
DEFAULT_MAX_PER_RUN = 3
DEFAULT_MAX_PER_DAY = 20
USAGE_STATE_PATH = Path.home() / ".cache" / "mnemosyne" / "enrich-usage.json"

_STUB_LINE_RE = re.compile(r'^\s*-\s+\[\[([^\]]+)\]\]\s+\|[^|]+\|\s+\[STUB\]')

# Raw photo / image captures awaiting OCR are NOT Sonnet-enrichable — they belong
# in the Vertex/Gemini OCR path, not here. Skip them so they don't burn the cap
# budget on guaranteed failures. (Wiring the OCR route is separate work.)
_SKIP_TITLE_RE = re.compile(
    r'(telegram photo|photo from telegram|pending ocr|image pending)', re.I
)

# The subscription session/usage-limit message claude prints when the rolling
# window is exhausted. Detect it to abort the whole run instead of hammering
# every remaining stub with calls that are guaranteed to fail.
_LIMIT_RE = re.compile(r'(session|usage) limit|hit your .*limit', re.I)

ENRICH_PROMPT_TEMPLATE = """\
You are the Mnemosyne Enrichment Agent. Enrich the stub wiki page described below.

== FULL SCHEMA ==
{schema}

== TODAY'S DATE ==
{today}

== STUB TO ENRICH ==
Title: {title}
Fact-check age threshold: {fact_check_age} days

== INSTRUCTIONS ==

1. Read the stub page for [[{title}]]. Locate it by searching the bucket directories
   if the path is not immediately obvious from the title.

2. Read index.md. Look for existing pages covering the same topic, entity, or theme
   where the stub content logically belongs or should be merged.
   Pay particular attention to IDEA pages — the schema requires new insights on the
   same theme to extend the existing page rather than create a new one.

3a. IF a merge candidate exists:
    - Read the candidate page
    - Merge the stub content into it (extend, never duplicate)
    - Update the candidate's `updated` frontmatter field to {today}
    - Update the candidate's index.md summary if stale
    - Delete the stub page file
    - Remove the stub's index.md entry entirely
    - Add to the END of log.md (after all existing entries):
      {log_timestamp} | update | BUCKET | <candidate title> | triage-enrich

3b. IF no merge candidate:
    - Enrich the body: expand the raw text into structured Markdown with
      bucket-appropriate headings and formatting
    - Add [[wikilinks]] wherever named people, projects, or pursuits are mentioned
    - Remove 'stub' from the tags list; set `updated` to {today}
    - Update the stub's index.md entry: replace [STUB] with the correct prefix:
        - ADMIN stubs: replace [STUB] with [User] (task_type: user) or [Maintenance]
          (task_type: maintenance), per the schema's ADMIN index convention
        - All other buckets: remove [STUB] entirely (no replacement prefix)
      Refresh the summary text if stale.
    - Add to the END of log.md (after all existing entries):
      {log_timestamp} | update | BUCKET | {title} | triage-enrich

    - UNFINISHED-FLAGGING (applies to all buckets):
      After writing the enriched body, count its words. If the body is under 150
      words OR the content remains substantively incomplete (placeholder text,
      single-sentence assertions without elaboration, no resolution of the
      obvious questions the stub raised), then in frontmatter:
        - set `status: draft`
        - add `unfinished` to the `tags:` list (if not already present)
      Otherwise:
        - if `status: draft` was present, REMOVE it (do not set to null;
          delete the line)
        - if `unfinished` was in `tags:`, REMOVE it
      The 150-word threshold and the substance check apply uniformly across
      all buckets. The daily-digest currently consumes this signal only for
      IDEA pages, but other tooling (audits, future digests, future surfaces)
      will read it from any bucket.

      ADMIN exception: do NOT apply unfinished-flagging to ADMIN pages.
      ADMIN's `status:` field already has a controlled vocabulary
      (Pending / Done / Completed / etc.) and must not be overwritten with
      `draft`. Leave ADMIN status untouched.

4. Assess whether any ADMIN task is warranted. Create a task page for each that applies.
   Apply filename sanitization rules (from the schema) to the task title if needed.

   a. USER CLARIFICATION NEEDED — content intent is unclear, classification may be
      wrong, or key context only the user can supply is missing:
      → Create admin/User Clarification - {title}.md
        frontmatter: bucket: ADMIN, task_type: user, status: Pending, due: null,
                     created: {today}, updated: {today}, source: triage-enrich, tags: []
        index.md:    [[User Clarification - {title}]] | ADMIN | [User] Pending — clarification needed for [[{title}]]
        log.md (END): {log_timestamp} | ingest | ADMIN | User Clarification - {title} | triage-enrich

   b. FACT-CHECK — this is a REFERENCE page AND the `created` date is more than
      {fact_check_age} days before {today} AND the content is time-sensitive
      (technology versions, software documentation, AI model specs, statistics,
      dated factual claims):
      → Create admin/Fact-Check {title}.md
        frontmatter: bucket: ADMIN, task_type: maintenance, status: Pending, due: null,
                     created: {today}, updated: {today}, source: triage-enrich, tags: []
        index.md:    [[Fact-Check {title}]] | ADMIN | [Maintenance] Pending — fact-check [[{title}]]
        log.md (END): {log_timestamp} | ingest | ADMIN | Fact-Check {title} | triage-enrich

Do NOT commit, push, or run shell commands.
Do NOT modify any file other than those explicitly described above.
"""


# ── Helpers ───────────────────────────────────────────────────────────────────

def load_schema(wiki_root: Path) -> str:
    schema_path = wiki_root / SCHEMA_FILENAME
    try:
        return schema_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        print(f"Error: {SCHEMA_FILENAME} not found at {schema_path}", file=sys.stderr)
        sys.exit(1)


def find_stubs(wiki_root: Path) -> list[str]:
    """Return page titles with [STUB] in index.md, in index order."""
    index_path = wiki_root / INDEX_FILENAME
    try:
        lines = index_path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        print(f"Error: {INDEX_FILENAME} not found at {index_path}", file=sys.stderr)
        sys.exit(1)

    return [
        m.group(1)
        for line in lines
        if (m := _STUB_LINE_RE.match(line))
    ]


def build_prompt(schema: str, title: str, fact_check_age: int) -> str:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    log_timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return ENRICH_PROMPT_TEMPLATE.format(
        schema=schema,
        today=today,
        title=title,
        fact_check_age=fact_check_age,
        log_timestamp=log_timestamp,
    )


def enrich_stub(
    title: str,
    wiki_root: Path,
    schema: str,
    fact_check_age: int,
    dry_run: bool,
) -> str:
    """Enrich a single stub. Returns 'ok', 'fail', or 'limit'.

    'limit' means claude reported a session/usage-limit; the caller must stop the
    whole run rather than try the next stub.
    """
    if dry_run:
        print(f"[dry-run] Would enrich: {title}")
        return "ok"

    prompt = build_prompt(schema, title, fact_check_age)

    print(f"Enriching: {title}", file=sys.stderr)
    result = subprocess.run(
        [
            str(Path.home() / ".local" / "bin" / "claude"),
            "--model", SONNET_MODEL,
            "-p", prompt,
            "--allowedTools", "Read,Edit,Write",
        ],
        capture_output=True,
        text=True,
        cwd=str(wiki_root),
    )

    # Forward claude's output so cron logs keep full detail (we now capture it so
    # we can inspect it for the limit message).
    if result.stdout:
        sys.stderr.write(result.stdout)
    if result.stderr:
        sys.stderr.write(result.stderr)
    combined = f"{result.stdout or ''}\n{result.stderr or ''}"

    if _LIMIT_RE.search(combined):
        print(f"Session/usage limit reached during '{title}' — aborting run.",
              file=sys.stderr)
        return "limit"
    if result.returncode != 0:
        print(f"Error: claude exited {result.returncode} for '{title}'", file=sys.stderr)
        return "fail"

    print(f"Done: {title}", file=sys.stderr)
    return "ok"


def load_usage_today() -> int:
    """Stubs already enriched in the current UTC day (0 if new day / no state)."""
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    try:
        data = json.loads(USAGE_STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 0
    return int(data.get("count", 0)) if data.get("date") == today else 0


def save_usage_today(count: int) -> None:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    USAGE_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    USAGE_STATE_PATH.write_text(
        json.dumps({"date": today, "count": count}), encoding="utf-8"
    )


# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--page", metavar="TITLE",
        help="Enrich a single stub by page title",
    )
    parser.add_argument(
        "--wiki-root", type=Path, default=DEFAULT_WIKI_ROOT, metavar="DIR",
        help=f"Wiki root directory (default: {DEFAULT_WIKI_ROOT})",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="List stubs found without calling claude",
    )
    parser.add_argument(
        "--fact-check-age", type=int, default=DEFAULT_FACT_CHECK_AGE, metavar="N",
        help=f"Days threshold for stale REFERENCE content (default: {DEFAULT_FACT_CHECK_AGE})",
    )
    parser.add_argument(
        "--max-per-run", type=int, default=DEFAULT_MAX_PER_RUN, metavar="N",
        help=f"Max stubs to enrich this run, 0=unlimited (default: {DEFAULT_MAX_PER_RUN})",
    )
    parser.add_argument(
        "--max-per-day", type=int, default=DEFAULT_MAX_PER_DAY, metavar="N",
        help=f"Max stubs to enrich per UTC day, 0=unlimited (default: {DEFAULT_MAX_PER_DAY})",
    )
    args = parser.parse_args()

    wiki_root: Path = args.wiki_root
    if not wiki_root.exists():
        print(f"Error: wiki root not found: {wiki_root}", file=sys.stderr)
        sys.exit(1)

    schema = load_schema(wiki_root)

    if args.page:
        stubs = find_stubs(wiki_root)
        if args.page not in stubs:
            print(
                f"Error: '{args.page}' not found as a [STUB] in index.md",
                file=sys.stderr,
            )
            sys.exit(1)
        status = enrich_stub(args.page, wiki_root, schema, args.fact_check_age, args.dry_run)
        sys.exit(0 if status == "ok" else 1)

    all_stubs = find_stubs(wiki_root)
    if not all_stubs:
        print("No stubs found in index.md.", file=sys.stderr)
        sys.exit(0)

    # Set aside un-enrichable photo/OCR-pending stubs so they don't waste budget.
    skipped = [t for t in all_stubs if _SKIP_TITLE_RE.search(t)]
    stubs = [t for t in all_stubs if not _SKIP_TITLE_RE.search(t)]
    if skipped:
        print(f"Skipping {len(skipped)} photo/OCR-pending stub(s) (need the OCR path, "
              f"not Sonnet enrichment).", file=sys.stderr)
    if not stubs:
        print("No enrichable stubs after the OCR-pending skip.", file=sys.stderr)
        sys.exit(0)

    # Apply the per-day then per-run caps.
    used_today = load_usage_today()
    day_remaining = (args.max_per_day - used_today) if args.max_per_day > 0 else len(stubs)
    if day_remaining <= 0:
        print(f"Daily enrich cap reached ({used_today}/{args.max_per_day}); skipping run.",
              file=sys.stderr)
        sys.exit(0)
    run_cap = args.max_per_run if args.max_per_run > 0 else len(stubs)
    budget = min(run_cap, day_remaining, len(stubs))
    batch = stubs[:budget]

    print(f"Found {len(stubs)} enrichable stub(s); processing {len(batch)} this run "
          f"(run cap {run_cap or '∞'}, day {used_today}/{args.max_per_day or '∞'}).",
          file=sys.stderr)

    processed = failed = 0
    aborted = False
    for title in batch:
        status = enrich_stub(title, wiki_root, schema, args.fact_check_age, args.dry_run)
        if status == "limit":
            print("Aborting run — remaining stubs left for the next run.", file=sys.stderr)
            aborted = True
            break
        processed += 1  # consumed usage (ok or fail), counts against the daily cap
        if status == "fail":
            failed += 1

    if not args.dry_run and processed:
        save_usage_today(used_today + processed)

    print(f"Run complete: {processed} processed ({failed} failed), "
          f"day total {used_today + processed}/{args.max_per_day or '∞'}"
          f"{' — limit-aborted' if aborted else ''}.", file=sys.stderr)
    if failed or aborted:
        sys.exit(1)


if __name__ == "__main__":
    main()

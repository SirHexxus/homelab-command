#!/usr/bin/env python3
"""Set an ADMIN task's `status:` to a canonical state — idempotently.

Closing (or re-opening) a task is otherwise a hand edit nobody performs, so
finished tasks linger as `status: Pending` and keep surfacing in the daily
digest. This makes the flip a single command for James, Claude, or Hermes.

The target state is validated against the canonical vocabulary
(`lib/task_status.py` / `schema/statuses.json`) — an unknown word is rejected
rather than written, which is what stops typo/case drift at the source. When the
task is already in the target state the script is a no-op.

On a real change it rewrites the `status:` line, bumps `updated:` to today,
stamps `reviewed:` (a status change is a decision, so it restarts the task's
attention window — see lib/task_priority.py), sets `closed:` to today when the
task closes (removing it on reopen, for the throughput metric), and records an
`update` event in `mneme_log`.

Usage:
  set-task-status "<task-title>" <state> [--dry-run]
  set-task-status "Apply Weekly Work Schedule" Done
  set-task-status "Configure Bazarr" Active --dry-run

`<task-title>` is the admin page filename without the `.md` extension.
"""

from __future__ import annotations

import argparse
import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import admin_page  # noqa: E402
import mneme_log  # noqa: E402
import task_status  # noqa: E402
import wiki_git  # noqa: E402

DEFAULT_WIKI_ROOT = Path.home() / "mneme" / "wiki"


def apply_status(path: Path, new_status: str, today: str,
                 dry_run: bool) -> tuple[bool, str]:
    """Set status and its dates in the frontmatter. Return (changed, current_status).

    `changed` is False when the task is already in `new_status` (no write). With
    `dry_run` the file is left untouched but the would-be `changed` flag and the
    current status are still reported.
    """
    text = path.read_text(encoding="utf-8")
    if admin_page.split_frontmatter(text)[1] == -1:
        raise ValueError(f"{path.name}: no YAML frontmatter")
    fields = admin_page.read_fields(text)
    if "status" not in fields:
        raise ValueError(f"{path.name}: no status field in frontmatter")

    current = fields["status"]
    if current.lower() == new_status.lower():
        return False, current
    if dry_run:
        return True, current

    updates: dict[str, str | None] = {"status": new_status, "reviewed": today}
    if "updated" in fields:
        updates["updated"] = today
    updates["closed"] = today if task_status.is_closed(new_status) else None
    path.write_text(admin_page.set_fields(text, updates), encoding="utf-8")
    return True, current


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("title", help="admin page filename without .md")
    parser.add_argument("state", help="target status (e.g. Done, Skipped, Active)")
    parser.add_argument("--wiki-root", type=Path, default=DEFAULT_WIKI_ROOT,
                        metavar="DIR", help=f"wiki root (default: {DEFAULT_WIKI_ROOT})")
    parser.add_argument("--dry-run", action="store_true",
                        help="report the intended change without writing")
    args = parser.parse_args()

    canon = task_status.canonical(args.state)
    if canon is None:
        known = ", ".join(sorted(task_status.ALL_STATUSES))
        print(f"Error: {args.state!r} is not a known status. Known: {known}",
              file=sys.stderr)
        return 2

    path = admin_page.resolve_task(args.wiki_root, args.title)
    if path is None:
        return 1

    today = date.today().isoformat()
    try:
        changed, previous = apply_status(path, canon, today, args.dry_run)
    except (OSError, ValueError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    prefix = "[dry-run] " if args.dry_run else ""
    if not changed:
        print(f"{prefix}{args.title}: already {canon} — no change")
        return 0

    if args.dry_run:
        print(f"[dry-run] {args.title}: {previous or '(none)'} -> {canon}; "
              f"would stamp updated/reviewed{'/closed' if task_status.is_closed(canon) else ''} "
              f"to {today} and log an update event")
        return 0

    mneme_log.log_event("update", "ADMIN", args.title, "set-task-status")
    wiki_git.commit_wiki_changes(args.wiki_root, [path], "task",
                                 f"{args.title}: {previous or 'none'} -> {canon}")
    print(f"{args.title}: {previous or '(none)'} -> {canon}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
